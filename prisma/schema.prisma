generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleCategory {
  frontend
  backend
  ai_ml
  security
  devops
  database
  mobile
  web3
  design
  testing
  performance
  architecture
}

enum EmbeddingKey {
  title
  summary
  content
}

enum SkipReason {
  PDF // PDFファイル
  SLIDE // スライド資料
  THIN_CONTENT // コンテンツ不足
  CONTENT_FETCH_FAILED // コンテンツ取得失敗
  QUALITY_FAILED // 品質基準未達
}

enum CommentVisibility {
  PUBLIC
  PRIVATE
}

model Article {
  id                     String             @id @default(cuid())
  title                  String
  translatedTitle        String? // 日本語翻訳タイトル
  url                    String             @unique
  summary                String?
  thumbnail              String?
  content                String?
  publishedAt            DateTime           @db.Timestamptz(6)
  sourceId               String
  bookmarks              Int                @default(0)
  qualityScore           Float              @default(0)
  userVotes              Int                @default(0)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)
  difficulty             String?
  detailedSummary        String?
  articleType            String?
  summaryVersion         Int                @default(8)
  category               ArticleCategory?
  contentUpdatedAt       DateTime?          @db.Timestamptz(6)
  qualityScoreComputedAt DateTime?          @db.Timestamptz(6)
  summaryComputedAt      DateTime?          @db.Timestamptz(6)
  skipReason             SkipReason? // スキップ理由（NULL = 正常生成）
  summaryError           String? // エラーメッセージ（NULL = エラーなし）
  source                 Source             @relation(fields: [sourceId], references: [id])
  articleViews           ArticleView[]
  favorites              Favorite[]
  tags                   Tag[]              @relation("ArticleToTag")
  embeddings             ArticleEmbedding[]
  chunks                 ArticleChunk[]
  embeddingJob           EmbeddingJob?
  comments               Comment[]
  codeTips               CodeTip[]

  @@index([publishedAt(sort: Desc)], map: "idx_article_published_at")
  @@index([sourceId], map: "idx_article_source_id")
  @@index([sourceId, publishedAt(sort: Desc)], map: "idx_article_source_published")
  @@index([createdAt(sort: Desc)], map: "idx_article_created_at")
  @@index([qualityScore(sort: Desc)], map: "idx_article_quality_score")
  @@index([updatedAt], map: "idx_article_updated_at")
  @@index([bookmarks(sort: Desc)])
  @@index([contentUpdatedAt], map: "idx_article_content_updated_at")
  @@index([qualityScoreComputedAt], map: "idx_article_quality_score_computed_at")
  @@index([summaryComputedAt], map: "idx_article_summary_computed_at")
  @@index([skipReason], map: "idx_article_skip_reason")
}

model Source {
  id             String                @id @default(cuid())
  name           String                @unique
  type           String
  url            String
  enabled        Boolean               @default(true)
  groupId        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  articles       Article[]
  group          SourceGroup?          @relation(fields: [groupId], references: [id])
  tagAssignments SourceTagAssignment[]

  @@index([groupId], map: "idx_source_group_id")
}

model Tag {
  id               String               @id @default(cuid())
  name             String               @unique
  category         String?
  articles         Article[]            @relation("ArticleToTag")
  categoryMappings TagCategoryMapping[]

  @@index([name], map: "idx_tag_name")
}

model User {
  id                          String                   @id @default(cuid())
  email                       String                   @unique
  emailVerified               DateTime?
  name                        String?
  image                       String?
  password                    String?
  role                        String?                  @default("user") // "user" | "admin"
  deletedAt                   DateTime?                @db.Timestamptz(6)
  personalizationPeriodMonths Int                      @default(12) // Time period for personalized filtering (0 = all time)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  accounts                    Account[]
  articleViews                ArticleView[]
  favorites                   Favorite[]
  categoryPreferences         UserCategoryPreference[]
  comments                    Comment[]
  sourcePresets                UserSourcePreset[]

  @@index([deletedAt], map: "idx_user_deleted_at")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model ArticleView {
  id        String    @id @default(cuid())
  userId    String
  articleId String
  viewedAt  DateTime?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, viewedAt])
  @@index([articleId])
  @@index([userId, isRead])
}

// =============================================================================
// Trend Reports: Daily/Weekly/Monthly trend analysis with AI summaries
// (WeeklyDigest has been deprecated and replaced by TrendReport)
// =============================================================================

enum TrendPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

model TrendReport {
  id            String          @id @default(cuid())
  periodType    TrendPeriodType
  periodStart   DateTime        @db.Timestamptz(6)
  periodEnd     DateTime        @db.Timestamptz(6)
  articleCount  Int
  topArticles   Json // Top articles with scores
  categories    Json // Category distribution
  tags          Json // Tag rankings
  aiSummary     String?         @db.Text
  aiModel       String? // e.g., "gemini-2.5-flash-lite"
  promptVersion String? // For AI audit trail
  generatedAt   DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([periodType, periodStart])
  @@index([periodType, periodStart(sort: Desc)], map: "idx_trend_report_period")
}

model ProcessingLog {
  id              String           @id @default(cuid())
  processName     String           @unique
  lastProcessedAt DateTime
  processedCount  Int              @default(0)
  status          ProcessingStatus @default(success)
  metadata        Json? // Additional processing information
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([lastProcessedAt], map: "idx_processing_log_processed_at")
}

enum ProcessingStatus {
  success
  failed
  partial
}

model UserDeletionLog {
  id         String   @id @default(cuid())
  userId     String
  email      String
  reason     String?
  authMethod String?
  clientIp   String?
  userAgent  String?
  deletedAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([deletedAt], map: "idx_user_deletion_log_deleted_at")
  @@index([email], map: "idx_user_deletion_log_email")
}

model ArticleEmbedding {
  id           String                      @id @default(cuid())
  articleId    String
  embeddingKey EmbeddingKey
  embedding    Unsupported("vector(1536)")
  model        String                      @default("text-embedding-3-small")
  version      Int                         @default(1)
  computedAt   DateTime                    @default(now()) @db.Timestamptz(6)
  article      Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, embeddingKey, model, version])
  @@index([articleId], map: "idx_article_embedding_article_id")
  @@index([model, version], map: "idx_article_embedding_model_version")
  @@index([embeddingKey], map: "idx_article_embedding_key")
  @@index([computedAt], map: "idx_article_embedding_computed_at")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("job_status")
}

model EmbeddingJob {
  id          String    @id @default(cuid())
  articleId   String    @unique
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  queuedAt    DateTime  @default(now()) @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt], map: "idx_embedding_job_status_queued")
  @@map("embedding_jobs")
}

model ArticleChunk {
  id         String                      @id @default(cuid())
  articleId  String
  chunkIndex Int
  text       String
  embedding  Unsupported("vector(1536)")
  model      String                      @default("text-embedding-3-small")
  version    Int                         @default(1)
  createdAt  DateTime                    @default(now()) @db.Timestamptz(6)
  article    Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex, model, version])
  @@index([articleId, chunkIndex], map: "idx_article_chunk_article_index")
}

model SourceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String
  description String?
  ordering    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  sources     Source[]

  @@index([type], map: "idx_source_group_type")
  @@index([ordering], map: "idx_source_group_ordering")
}

model SourceTag {
  id          String                @id @default(cuid())
  name        String                @unique
  category    String?
  description String?
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)
  assignments SourceTagAssignment[]

  @@index([category], map: "idx_source_tag_category")
}

model SourceTagAssignment {
  id        String    @id @default(cuid())
  sourceId  String
  tagId     String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  source    Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tag       SourceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([sourceId, tagId], map: "uq_source_tag_assignment")
  @@index([sourceId], map: "idx_source_tag_assignment_source")
  @@index([tagId], map: "idx_source_tag_assignment_tag")
}

// =============================================================================
// Personalization: Interest Categories
// =============================================================================

model InterestCategory {
  id                 String                       @id @default(cuid())
  slug               String                       @unique
  name               String
  description        String?
  icon               String?
  sortOrder          Int                          @default(0)
  isActive           Boolean                      @default(true)
  centroidEmbedding  Unsupported("vector(1536)")?
  centroidComputedAt DateTime?                    @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  tagMappings        TagCategoryMapping[]
  userPreferences    UserCategoryPreference[]

  @@index([slug], map: "idx_interest_category_slug")
  @@index([sortOrder], map: "idx_interest_category_sort_order")
  @@index([isActive], map: "idx_interest_category_is_active")
}

model TagCategoryMapping {
  id         String           @id @default(cuid())
  tagId      String
  categoryId String
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  tag        Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)
  category   InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tagId, categoryId], map: "uq_tag_category_mapping")
  @@index([tagId], map: "idx_tag_category_mapping_tag")
  @@index([categoryId], map: "idx_tag_category_mapping_category")
}

model UserCategoryPreference {
  id         String           @id @default(cuid())
  userId     String
  categoryId String
  weight     Int              @default(1)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   InterestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId], map: "uq_user_category_preference")
  @@index([userId], map: "idx_user_category_preference_user")
  @@index([categoryId], map: "idx_user_category_preference_category")
}

// =============================================================================
// Comments: Private notes on articles (MVP - Phase 1)
// =============================================================================

model Comment {
  id         String            @id @default(cuid())
  articleId  String
  userId     String
  content    String            @db.Text
  visibility CommentVisibility @default(PRIVATE)
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime?         @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // MVP用インデックス（プライベートコメント専用）
  @@index([articleId, userId, deletedAt, createdAt(sort: Desc), id], map: "idx_comment_article_user_private")
  // ユーザー別コメント一覧用
  @@index([userId, deletedAt, createdAt(sort: Desc), id], map: "idx_comment_user_list")
}

// =============================================================================
// AI Analysis: Batch-generated AI insights (Diff Summary, Viewpoint Map, Code Tips)
// =============================================================================

// Note: BatchStatus is intentionally separate from ProcessingStatus.
// - BatchStatus uses UPPERCASE for AI analysis batch jobs
// - ProcessingStatus uses lowercase for general processing logs
// This separation allows independent evolution of each domain's status values.
enum BatchStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model DiffSummary {
  id             String      @id @default(cuid())
  categorySlug   String
  currentPeriod  String // "2026-W01"
  baselinePeriod String // "2025-W52"
  changes        Json // Structured diff information
  unchanged      String[] // Unchanged items
  status         BatchStatus @default(SUCCESS)
  errorMessage   String?     @db.Text
  modelVersion   String
  promptVersion  String
  generatedAt    DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([categorySlug, currentPeriod], map: "uq_diff_summary_category_period")
  @@index([categorySlug], map: "idx_diff_summary_category_slug")
  @@index([generatedAt(sort: Desc)], map: "idx_diff_summary_generated_at")
  @@index([status], map: "idx_diff_summary_status")
}

model ViewpointMap {
  id            String      @id @default(cuid())
  topicSlug     String
  period        String // "2026-W01" (weekly history preservation)
  issues        Json // List of viewpoints/issues
  articleIds    String[] // Referenced article IDs
  status        BatchStatus @default(SUCCESS)
  errorMessage  String?     @db.Text
  modelVersion  String
  promptVersion String
  generatedAt   DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([topicSlug, period], map: "uq_viewpoint_map_topic_period")
  @@index([generatedAt(sort: Desc)], map: "idx_viewpoint_map_generated_at")
  @@index([status], map: "idx_viewpoint_map_status")
}

model CodeTip {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  code            String   @db.Text
  codeHash        String // Hash for deduplication
  language        String
  tags            String[]
  sourceArticleId String
  quality         Float
  modelVersion    String
  promptVersion   String
  extractedAt     DateTime @default(now()) @db.Timestamptz(6)

  sourceArticle Article @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([sourceArticleId, codeHash], map: "uq_code_tip_article_hash")
  @@index([language], map: "idx_code_tip_language")
  @@index([quality(sort: Desc)], map: "idx_code_tip_quality")
  @@index([extractedAt(sort: Desc)], map: "idx_code_tip_extracted_at")
}

// =============================================================================
// Social Post: X (Twitter) post content management (Admin only)
// =============================================================================

enum SocialPostStatus {
  DRAFT // Generated draft
  REVIEWED // Admin reviewed
  SCHEDULED // Scheduled for posting
  POSTING // Currently posting
  POSTED // Posted successfully
  FAILED // Posting failed
  ARCHIVED // Archived (not to be posted)
}

enum SocialPostSource {
  ARTICLE // Generated from individual article
  DAILY_TREND // Generated from Daily Trend
  DIFF_SUMMARY // Generated from Diff Summary
  OPINION // Generated from trend analysis (personal opinion style)
  MANUAL // Manually created
}

model SocialPost {
  id              String           @id @default(cuid())
  // Content
  content         String           @db.Text // Post body (~100 chars)
  originalContent String?          @db.Text // Pre-edit content (for audit)
  hashtags        String[] // Multiple hashtags support
  sourceUrls      String[] // Source URLs (multiple support)
  // Source info
  source          SocialPostSource
  sourceIds       String[] // Reference IDs (multiple support)
  // Duplicate prevention
  contentHash     String? // Content hash for duplicate detection
  // Status
  status          SocialPostStatus @default(DRAFT)
  // AI generation metadata
  modelVersion    String?
  promptVersion   String?
  contextSummary  String?          @db.Text // Context summary at generation (safe format)
  // Schedule & posting
  scheduledAt     DateTime?        @db.Timestamptz(6)
  postedAt        DateTime?        @db.Timestamptz(6)
  externalPostId  String? // X post ID
  postError       String?          @db.Text // Posting error details
  // Audit info
  createdBy       String? // Creator ID
  reviewedBy      String? // Reviewer ID
  reviewedAt      DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  // Relations
  auditLogs       SocialPostAuditLog[]

  @@unique([contentHash], map: "uq_social_post_content_hash")
  @@index([status, createdAt(sort: Desc)], map: "idx_social_post_status_created")
  @@index([source], map: "idx_social_post_source")
  @@index([scheduledAt], map: "idx_social_post_scheduled_at")
  @@index([postedAt(sort: Desc)], map: "idx_social_post_posted_at")
  @@index([createdBy], map: "idx_social_post_created_by")
}

// Audit log for social posts
model SocialPostAuditLog {
  id           String     @id @default(cuid())
  socialPostId String? // Nullable to preserve audit logs after post deletion
  action       String // CREATE, UPDATE, DELETE, GENERATE, PUBLISH, REVIEW
  userId       String? // Operator ID
  previousData Json? // Data before change
  newData      Json? // Data after change
  ipAddress    String? // Client IP (Note: Consider anonymization for GDPR/CCPA compliance)
  userAgent    String? // Browser info (Note: Consider retention policy for PII)
  metadata     Json? // Additional info
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  socialPost SocialPost? @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  @@index([socialPostId, createdAt(sort: Desc)], map: "idx_social_post_audit_log")
  @@index([userId], map: "idx_social_post_audit_user")
  @@index([action], map: "idx_social_post_audit_action")
}

// =============================================================================
// User Source Presets: Named source filter configurations
// =============================================================================

model UserSourcePreset {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(50)
  sourceIds String[]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Note: The actual DB constraint uses lower(name) for case-insensitive uniqueness.
  // See migration: 20260208130321_add_user_source_preset
  @@unique([userId, name], map: "uq_user_source_preset_name")
  @@index([userId], map: "idx_user_source_preset_user")
}
