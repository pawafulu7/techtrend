generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleCategory {
  frontend
  backend
  ai_ml
  security
  devops
  database
  mobile
  web3
  design
  testing
  performance
  architecture
}

enum EmbeddingKey {
  title
  summary
  content
}

enum SkipReason {
  PDF // PDFファイル
  SLIDE // スライド資料
  THIN_CONTENT // コンテンツ不足
  CONTENT_FETCH_FAILED // コンテンツ取得失敗
  QUALITY_FAILED // 品質基準未達
}

model Article {
  id                     String             @id @default(cuid())
  title                  String
  translatedTitle        String? // 日本語翻訳タイトル
  url                    String             @unique
  summary                String?
  thumbnail              String?
  content                String?
  publishedAt            DateTime           @db.Timestamptz(6)
  sourceId               String
  bookmarks              Int                @default(0)
  qualityScore           Float              @default(0)
  userVotes              Int                @default(0)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)
  difficulty             String?
  detailedSummary        String?
  articleType            String?
  summaryVersion         Int                @default(8)
  category               ArticleCategory?
  contentUpdatedAt       DateTime?          @db.Timestamptz(6)
  qualityScoreComputedAt DateTime?          @db.Timestamptz(6)
  summaryComputedAt      DateTime?          @db.Timestamptz(6)
  skipReason             SkipReason? // スキップ理由（NULL = 正常生成）
  summaryError           String? // エラーメッセージ（NULL = エラーなし）
  critique               Json? // AI評価（JSONB: {contextComparison, recommendedAudience, valueAssessment, updatedAt}）
  critiqueVersion        Int? // 批評バージョン
  source                 Source             @relation(fields: [sourceId], references: [id])
  articleViews           ArticleView[]
  favorites              Favorite[]
  tags                   Tag[]              @relation("ArticleToTag")
  embeddings             ArticleEmbedding[]
  chunks                 ArticleChunk[]
  embeddingJob           EmbeddingJob?

  @@index([publishedAt(sort: Desc)], map: "idx_article_published_at")
  @@index([sourceId], map: "idx_article_source_id")
  @@index([sourceId, publishedAt(sort: Desc)], map: "idx_article_source_published")
  @@index([createdAt(sort: Desc)], map: "idx_article_created_at")
  @@index([qualityScore(sort: Desc)], map: "idx_article_quality_score")
  @@index([updatedAt], map: "idx_article_updated_at")
  @@index([bookmarks(sort: Desc)])
  @@index([contentUpdatedAt], map: "idx_article_content_updated_at")
  @@index([qualityScoreComputedAt], map: "idx_article_quality_score_computed_at")
  @@index([summaryComputedAt], map: "idx_article_summary_computed_at")
  @@index([skipReason], map: "idx_article_skip_reason")
}

model Source {
  id        String    @id @default(cuid())
  name      String    @unique
  type      String
  url       String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  category String?
  articles Article[] @relation("ArticleToTag")

  @@index([name], map: "idx_tag_name")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          String?       @default("user") // "user" | "admin"
  deletedAt     DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  articleViews  ArticleView[]
  favorites     Favorite[]

  @@index([deletedAt], map: "idx_user_deleted_at")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model ArticleView {
  id        String    @id @default(cuid())
  userId    String
  articleId String
  viewedAt  DateTime?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, viewedAt])
  @@index([articleId])
  @@index([userId, isRead])
}

model WeeklyDigest {
  id            String   @id @default(cuid())
  weekStartDate DateTime @unique
  weekEndDate   DateTime
  articleCount  Int
  topArticles   Json
  categories    Json
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)], map: "idx_weekly_digest_created_at")
}

model ProcessingLog {
  id              String           @id @default(cuid())
  processName     String           @unique
  lastProcessedAt DateTime
  processedCount  Int              @default(0)
  status          ProcessingStatus @default(success)
  metadata        Json? // Additional processing information
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([lastProcessedAt], map: "idx_processing_log_processed_at")
}

enum ProcessingStatus {
  success
  failed
  partial
}

model UserDeletionLog {
  id         String   @id @default(cuid())
  userId     String
  email      String
  reason     String?
  authMethod String?
  clientIp   String?
  userAgent  String?
  deletedAt  DateTime @default(now()) @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([deletedAt], map: "idx_user_deletion_log_deleted_at")
  @@index([email], map: "idx_user_deletion_log_email")
}

model ArticleEmbedding {
  id           String                      @id @default(cuid())
  articleId    String
  embeddingKey EmbeddingKey
  embedding    Unsupported("vector(1536)")
  model        String                      @default("text-embedding-3-small")
  version      Int                         @default(1)
  computedAt   DateTime                    @default(now()) @db.Timestamptz(6)
  article      Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, embeddingKey, model, version])
  @@index([articleId], map: "idx_article_embedding_article_id")
  @@index([model, version], map: "idx_article_embedding_model_version")
  @@index([embeddingKey], map: "idx_article_embedding_key")
  @@index([computedAt], map: "idx_article_embedding_computed_at")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("job_status")
}

model EmbeddingJob {
  id          String    @id @default(cuid())
  articleId   String    @unique
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  queuedAt    DateTime  @default(now()) @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt], map: "idx_embedding_job_status_queued")
  @@map("embedding_jobs")
}

model ArticleChunk {
  id         String                      @id @default(cuid())
  articleId  String
  chunkIndex Int
  text       String
  embedding  Unsupported("vector(1536)")
  model      String                      @default("text-embedding-3-small")
  version    Int                         @default(1)
  createdAt  DateTime                    @default(now()) @db.Timestamptz(6)
  article    Article                     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, chunkIndex, model, version])
  @@index([articleId, chunkIndex], map: "idx_article_chunk_article_index")
}
