# E2E Test environment Dockerfile with Playwright
# Complete isolation from local environment - no volume mounts

FROM mcr.microsoft.com/playwright:v1.64.0-jammy

# Install additional dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
RUN mkdir -p /app && chown -R pwuser:pwuser /app

# Set working directory
WORKDIR /app

# Switch to pwuser for security
USER pwuser

# Copy package files
COPY --chown=pwuser:pwuser package*.json ./

# Copy prisma schema first (needed for npm ci postinstall)
COPY --chown=pwuser:pwuser prisma ./prisma

# Install dependencies (prisma generate runs automatically in postinstall)
RUN npm ci --no-audit --no-fund

# Install Playwright browsers
RUN npx playwright install chromium firefox webkit

# Copy all source files
COPY --chown=pwuser:pwuser . .

# Build Next.js application for E2E tests
# イメージを作る時点のビルド（下準備。テストの実行時は playwright の webServer が compose の環境変数で作り直す）。
# .env はイメージに入れないので、環境変数の検証を通すテスト用の値をこのビルドにだけ渡す
# （docker-compose.test.yml の AUTH_SECRET の既定値と同じ。イメージの ENV には残さない）
RUN AUTH_SECRET=test-secret-key-for-testing-only-32-chars npm run build

# Create necessary directories
RUN mkdir -p test-results playwright-report tmp .cache

# Set environment
ENV NODE_ENV=test
ENV CI=true

# Default command
CMD ["npm", "run", "test:e2e"]