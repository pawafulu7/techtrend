# .lintcolorsignore
#
# Allowlist for scripts/dev/lint-colors.mjs. Each entry must include one of
# the following provenance comments on the same line:
#
#   # TODO: remove after PR-N <reason>   — temporary entry tied to a follow-up PR.
#   # brand-only: <reason>               — permanent entry (brand identity colors).
#   # permanent: <reason>                — permanent entry (non-brand justification).
#
# Broad patterns like `app/**`, `components/**`, `lib/**`, `**/*`, `*` are
# rejected. Narrow entries to specific files or directories.
#
# Supported syntax:
#   - exact file paths: lib/utils/source/source-colors.ts
#   - trailing slash directories: app/dashboard/legacy/
#   - single-segment globs: app/components/**/foo*.tsx is NOT supported; use exact paths.

# Source brand identity colors (Qiita green, Zenn blue, etc.). Intentional hex/class pairs.
lib/utils/source/source-colors.ts # brand-only: source identity colors established by external brands
