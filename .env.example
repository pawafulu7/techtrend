# =============================================================================
# TechTrend 環境変数設定
# =============================================================================
# このファイルをコピーして .env ファイルを作成してください
# cp .env.example .env
#
# セキュリティ要件:
# - 本番環境では全ての SECRET/KEY/PASSWORD を必ず変更してください
# - シークレットキーはGitにコミットしないでください
# - 最小文字数要件を遵守してください
# =============================================================================

# --- 基本設定 ---
NODE_ENV=development
PORT=3000

# --- Feature Flags ---
# データベースバックエンドのProvider使用（Phase 2-A）
# true: DatabaseCompanySourceProvider使用
# false: StaticCompanySourceProvider使用（デフォルト）
USE_DATABASE_PROVIDER=false

# --- アプリケーションURL ---
# 開発環境: http://localhost:3000
# 本番環境例: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 認証・セキュリティ ---

# NextAuth シークレットキー
# 🔴 必須 | 最小32文字 | 本番環境では必ず変更
# 生成方法: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string-minimum-32-characters

# カーソルページネーション シークレットキー
# 🔴 本番環境で必須 | 64文字（32バイトHEX）
# 生成方法: openssl rand -hex 32
# 注意: 本番環境でこれがないとページネーション機能が動作しません
CURSOR_SECRET=replace-with-64-char-hex-string-generated-by-openssl-rand-hex-32

# OAuth プロバイダー（オプション）
# 🟡 オプション | Google/GitHubログインを有効にする場合に設定
# 取得方法:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Basic認証（オプション）---
# 全ルートをHTTP Basic認証で保護する場合に有効化
# 🟢 開発環境ではfalse推奨 | 本番環境での公開前保護に有用
BASIC_AUTH_ENABLED=false
BASIC_AUTH_PASS=
BASIC_AUTH_USER=admin
# または BASIC_PASSWORD を使用可能

# --- データベース (PostgreSQL via Prisma) ---

# PostgreSQL パスワード
# 🔴 必須 | 本番環境では強力なパスワードを使用
POSTGRES_PASSWORD=postgres_dev_password

# データベース接続URL
# 🔴 必須 | Prismaが使用する接続文字列
# 開発環境: Docker Compose内のPostgreSQL
# 本番環境: Vercel PostgresまたはSupabaseのURL
#
# 接続プール最適化パラメータ:
# - connection_limit: 最大接続数（デフォルト: 10）
# - pool_timeout: 接続待機時間（秒、デフォルト: 10）
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/techtrend_dev?connection_limit=10&pool_timeout=10

# テスト用データベースURL
# 🟡 テスト実行時に使用 | 開発環境と分離して管理
TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/techtrend_test?connection_limit=10&pool_timeout=10

# ホスト側ツール用URL（E2Eセットアップ等）
DATABASE_URL_HOST=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/techtrend_dev?connection_limit=10&pool_timeout=10
TEST_DATABASE_URL_HOST=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5434/techtrend_test?connection_limit=10&pool_timeout=10

# 注意:
# - マイグレーションはビルドプロセスで自動実行されます（vercel-buildスクリプト）
# - Vercel Postgresを使用する場合、Prisma接続URLをコピーしてください

# --- Redis（統合接続） ---

# Redisパスワード
# 🔴 必須 | 開発環境でもパスワード保護を有効化
# 生成方法: openssl rand -base64 24
REDIS_PASSWORD=redis_dev_password

# Redis接続URL（推奨）
# 🟡 本番環境では強く推奨 | キャッシュ + セッション + レート制限に使用
# 用途: キャッシュ、セッション管理、レート制限（統合アーキテクチャ）
# Upstash Redis: rediss://default:***@***.upstash.io:6379
# ローカル開発: redis://:${REDIS_PASSWORD}@localhost:6379
# Docker環境: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=

# Redisフォールバック設定（REDIS_URLを使用しない場合）
# 🟢 ローカル開発用 | Docker ComposeのRedisを使用
REDIS_HOST=localhost
REDIS_PORT=6379

# 注意:
# - 本番環境ではREDIS_URLの使用を推奨（TLS対応）
# - Redisがない場合、キャッシュとレート制限が無効化（動作は継続）
# - キャッシュヒット率85%、レート制限保護のため本番環境ではRedis必須
# - 統合アーキテクチャ: 単一TCP接続でパフォーマンス改善（REST API廃止）
# - 開発環境でもパスワード保護を有効化（セキュリティベストプラクティス）

# --- メール認証 ---

# 送信元メールアドレス
# 🔴 必須（メール認証を使用する場合）
EMAIL_FROM=noreply@techtrend.example.com

# オプション1: Gmail（開発環境推奨）
# 🟡 開発環境推奨 | Gmailアプリパスワードを使用
# アプリパスワード取得: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
GMAIL_USER=your-gmail@gmail.com

# オプション2: Resend API
# 🟡 本番環境推奨 | 無料プランは制限あり
# 取得: https://resend.com/
# RESEND_API_KEY=

# オプション3: カスタムSMTP
# 🟢 任意のSMTPサーバーを使用する場合
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# 注意:
# - 3つのオプションのうち1つを選択してください
# - Gmailを使用する場合、2段階認証を有効にしてアプリパスワードを生成
# - 本番環境ではResendまたは専用SMTPサーバーを推奨

# --- AI（要約生成） ---

# Google Gemini APIキー
# 🔴 要約生成機能に必須 | Gemini 2.0 Flash-Liteを使用
# 取得方法: https://ai.google.dev/
# コスト: 約$1.89/月（8,000件の記事）
GEMINI_API_KEY=

# 使用するGeminiモデル
# 🟢 オプション | デフォルト: gemini-2.0-flash-lite
# 利用可能: gemini-2.0-flash-lite, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash-lite

# タイトル翻訳機能
# 🟢 オプション | デフォルト: true
# 英語タイトルを日本語に翻訳する機能の有効/無効
ENABLE_TITLE_TRANSLATION=true

# 翻訳のレート制限
# 🟢 オプション | デフォルト: 30記事/分
# API負荷を制御するための制限値
TRANSLATION_RATE_LIMIT=30

# --- RAG & Semantic Search (Phase 1 POC) ---

# OpenAI APIキー
# 🟡 RAG機能に必須 | ベクトル埋め込み生成 + AIエージェントに使用
# 取得方法: https://platform.openai.com/api-keys
# コスト: $0.02/1M tokens (約$1.50/年で10,000記事)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# AI Agent Configuration (Vercel AI SDK)
# 🟢 オプション | エージェント検索機能のデフォルト設定
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TOKENS=1000

# 埋め込みモデル設定
# 🟢 オプション | デフォルト: text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_CONCURRENCY=50
# ⚠️ IMPORTANT: EMBEDDING_DIMENSIONS must match the active embedding model
# - text-embedding-3-small: 1536 dimensions (current)
# - text-embedding-3-large: 3072 dimensions (future)
# Changing dimensions requires schema migration and re-embedding all articles
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MODEL=text-embedding-3-small

# RAG検索設定
# 🟢 オプション | セマンティック検索のデフォルト値
RAG_ACTIVE_MODEL=text-embedding-3-small
RAG_ACTIVE_VERSION=1
RAG_ENABLED=false
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=10

# 注意:
# - 開発環境: OpenAI API keyなしでも動作（RAG機能は無効化）
# - 開発環境: REDIS_URLなしでも動作（レート制限はメモリベースに自動フォールバック）
# - 本番環境: OPENAI_API_KEY + REDIS_URL推奨（セキュリティとコスト保護）

# --- ログ設定 ---

# ログレベル
# 🟢 オプション | debug, info, warn, error, fatal
# デフォルト: 本番環境=info、開発環境=debug
LOG_LEVEL=info

# --- Cron保護 ---

# Cron APIエンドポイント保護用トークン
# 🟡 推奨（本番環境） | /api/feeds/collect を手動呼び出しする際に必要
# 使用方法: Bearer認証 または ?token=パラメータ
# 生成方法: openssl rand -hex 16
CRON_TOKEN=

# --- Slack通知 ---

# Slack通知の有効化
# 🟢 オプション | デフォルト: false
# 記事収集完了時にSlackへ通知を送信
SLACK_NOTIFICATION_ENABLED=false

# Slack Incoming Webhook URL
# 🟢 オプション | SLACK_NOTIFICATION_ENABLED=true の場合に必須
# 取得方法: https://api.slack.com/apps → Incoming Webhooks
# 形式: https://hooks.slack.com/services/TXXXXX/BXXXXX/xxxxxxxx
SLACK_WEBHOOK_URL=

# --- 機能フラグ（オプション） ---

# AI Agent Search UI（RAG Phase 3）
# 🟢 デフォルト: false | AIエージェント検索UIを有効化
# 依存: OPENAI_API_KEY必須、REDIS_URL推奨
NEXT_PUBLIC_ENABLE_AI_SEARCH=false

# AI Agent Streaming API（RAG Phase 3.5）
# 🟢 デフォルト: false | エージェント検索のストリーミングAPIを有効化
# リアルタイム進捗表示（タイマーベースから実際のAI処理ベースへ）
AGENT_STREAMING_ENABLED=false

# AI Agent Streaming UI（Phase 0）
# デフォルト: true | ストリーミング表示UI（タイピングエフェクト、リアルタイム回答表示）
# false にすると従来の動作（ローダー → 完全な結果）に戻る
NEXT_PUBLIC_ENABLE_AGENT_STREAMING_UI=true

# AI Agent Chat UI（Phase 1 Step 1）
# デフォルト: false | Multi-turnチャット形式のAIエージェント検索UIを有効化
# true にすると /search/agent/chat でチャット形式の検索が利用可能
# false の場合は /search/agent にリダイレクト
NEXT_PUBLIC_ENABLE_AGENT_CHAT=false

# 認証機能の有効化
# 🟢 デフォルト: true | falseにすると全ユーザーがアクセス可能
ENABLE_AUTH=true

# キャッシュ機能の有効化
# 🟢 デフォルト: true | falseにするとパフォーマンスが低下
ENABLE_CACHE=true

# アナリティクス機能
# 🟢 デフォルト: false | ユーザー行動追跡が必要な場合に有効化
ENABLE_ANALYTICS=false

# AI要約品質チェック
# 🟢 デフォルト: false | 要約生成時の品質チェックを有効化
QUALITY_CHECK_ENABLED=false

# 品質スコア最小値
# 🟢 デフォルト: 70 | この値未満の要約は再生成
QUALITY_MIN_SCORE=70

# 最大再生成試行回数
# 🟢 デフォルト: 3 | 品質チェック失敗時の再試行回数
MAX_REGENERATION_ATTEMPTS=3

# --- バッチ処理最適化 ---

# 要約生成の並列度
# 🟢 デフォルト: 3 | Gemini APIへの同時リクエスト数
# 増やすとスループットが上がるが、レート制限リスクも増加
SUMMARY_CONCURRENCY=3

# 要約生成タイムアウト（ミリ秒）
# 🟢 デフォルト: 90000 (90秒) | 個々の要約生成のタイムアウト
SUMMARY_TIMEOUT=90000

# 要約生成リクエスト間の遅延（ミリ秒）
# 🟢 デフォルト: 500 | APIレート制限を回避するための遅延
SUMMARY_REQUEST_DELAY=500

# フィード収集の並列度
# 🟢 デフォルト: 7 | 同時に処理するソース数
# PM2/GHAスケジューラで使用
COLLECT_FEEDS_CONCURRENCY=7

# arXiv AI専用設定
# 🟢 オプション | arXiv論文取得の最適化設定
ARXIV_MAX_ARTICLES_PER_FETCH=200      # 1回あたりの最大取得件数
ARXIV_FETCHER_TIMEOUT_MS=600000       # フェッチャータイムアウト（ms、デフォルト10分）
ARXIV_ENRICHMENT_CONCURRENCY=8        # HTML取得の並列数

# --- Docker環境（macOS/非Linux用） ---

# Dockerコマンド実行時のファイルパーミッション設定
# 🟢 macOSユーザー向け | シェルプロファイルまたは.envで設定
# export HOST_UID=$(id -u)
# export HOST_GID=$(id -g)

# =============================================================================
# セットアップガイド
# =============================================================================
#
# 1. このファイルをコピー
#    cp .env.example .env
#
# 2. 必須項目を設定（🔴マーク）
#    - NEXTAUTH_SECRET（32文字以上）
#    - DATABASE_URL
#    - GEMINI_API_KEY（要約生成を使用する場合）
#
# 3. 推奨項目を設定（🟡マーク）
#    - CURSOR_SECRET（本番環境）
#    - REDIS_URL（本番環境）
#    - メール設定（認証機能を使用する場合）
#
# 4. オプション項目を必要に応じて設定（🟢マーク）
#
# =============================================================================
# 本番環境での注意事項
# =============================================================================
#
# ✅ 必ず実施:
# - 全てのシークレットキーを変更
# - 強力なパスワードを使用（最低16文字、大小英数字+記号）
# - CURSOR_SECRETを必ず設定（ないとページネーション失敗）
# - REDIS_URLを設定（パフォーマンス維持に必須）
#
# ✅ 推奨:
# - Vercel環境変数に設定（Vercel Project Settings）
# - シークレットは暗号化して管理
# - 定期的にローテーション（90日ごと）
#
# ✅ 禁止:
# - .envファイルをGitにコミット
# - シークレットをログに出力
# - 開発環境のシークレットを本番で使用
#
# =============================================================================
# セキュリティ設定
# =============================================================================
#
# 環境変数ファイルのパーミッション設定（必須）:
#   chmod 600 .env .env.local .env.production
#
# これにより所有者のみが読み書き可能になります。
# 新しい.envファイルを作成した場合は必ず実行してください。
#
# =============================================================================
