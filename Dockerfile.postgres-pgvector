# PostgreSQL with pgvector and Japanese locale support
# Based on official pgvector/pgvector:pg17 image

FROM pgvector/pgvector:pg17

# Install Japanese locale support
RUN apt-get update && \
    apt-get install -y locales && \
    sed -i '/ja_JP.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen ja_JP.UTF-8 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set default locale
ENV LANG=ja_JP.UTF-8 \
    LC_ALL=ja_JP.UTF-8

# Verify locale is available
RUN locale -a | grep ja_JP.utf8
