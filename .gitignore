lib/ai/testing/coverage-report.json
lib/ai/testing/candidate-pool-report.json
lib/ai/testing/backups/
regression-report.json
regression-report.md

# jest-dom snapshot output (should not be committed)
.jest-dom-partial.json

# test and temporary files
# More specific patterns to avoid excluding legitimate test files
scripts/test-temp-*.ts
scripts/temp-test-*.ts
scripts/debug-*.ts
test-email*.js
**/test-email*.js

# Explicitly include legitimate test directories
!scripts/test/**/*.ts
!__tests__/**/*.ts
!types/test-*.ts

# batch scripts
*.bat

# markdown documentation for setup
scripts/setup-*.md

# Claude Code related files (個人の作業ファイル)
.claude/
.kiro/
CLAUDE*
claudedocs/
*.claude.*
*claude-*.ts
.serena/
TROUBLESHOOTING.md

# Temporary scripts
scripts/temp/
scripts/fix-*.ts
scripts/check-*.ts
scripts/find-*.ts
scripts/regenerate-*.ts
# Removed duplicate patterns - now handled above with more specific rules

# Temporary files and directories
temp/
*-result-*.json
backup_*.json
problem-articles.json
deleted_scripts_list.txt

# Additional backup and test files
*.tar.gz
# SQLファイル（マイグレーションは除く）
*.sql
!prisma/migrations/**/*.sql

# Docker compose backup files
docker-compose.yml.backup*
docker-compose.*.backup*

# Temporary test files only - be more specific to avoid ignoring important test helpers
test-temp-*.ts
test-debug-*.ts
test-*.md

# Keep important test files
!lib/redis/test-redis-client.ts
!__tests__/**/test-*.ts
!__tests__/**/test-*.tsx

# Serena MCP cache and memories
.serena/cache/
.serena/memories/

# Playwright Test
/test-results/
/playwright-report/
/playwright/.cache/
