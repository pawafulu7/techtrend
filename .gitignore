otel-collector.log
.otel-collector/

# backup files
backup/
backups/
*.backup

# documentation files
docs/
!docs/operations/

# data and reports
data/
reports/

# AI Testing
lib/ai/testing/calibration-cache.json
lib/ai/testing/golden-set-calibrated.json
